# Docker Environment Variables
# Copy this file to .env.docker and configure for your environment

# Database Credentials (CHANGE IN PRODUCTION!)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here

# Redis Password (CHANGE IN PRODUCTION!)
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Secret (GENERATE SECURE KEY FOR PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_at_least_64_chars_long_random_string_here

# CORS Origins (update for production domains)
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000