# EventConnect Mobile App - Environment Variables Template
# Copy this file to .env.local for development or configure build secrets for production

# =======================
# API Configuration
# =======================
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_WS_URL=ws://localhost:5000

# Production URLs (uncomment for production builds)
# EXPO_PUBLIC_API_URL=https://api.eventconnect.com
# EXPO_PUBLIC_WS_URL=wss://api.eventconnect.com

# =======================
# Feature Flags
# =======================
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_LOCATION_SERVICES=true
EXPO_PUBLIC_ENABLE_CAMERA=true
EXPO_PUBLIC_ENABLE_DEEP_LINKS=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# =======================
# App Configuration
# =======================
EXPO_PUBLIC_APP_NAME="EventConnect"
EXPO_PUBLIC_APP_VERSION="2.0.0"
EXPO_PUBLIC_APP_BUILD_NUMBER="1"
EXPO_PUBLIC_MIN_APP_VERSION="2.0.0"

# =======================
# Cache Configuration
# =======================
EXPO_PUBLIC_CACHE_VERSION="2.0"
EXPO_PUBLIC_IMAGE_CACHE_SIZE="100"
EXPO_PUBLIC_DATA_CACHE_TTL="300000"

# =======================
# Security
# =======================
# Don't put sensitive keys here - use EAS Secrets for production
EXPO_PUBLIC_API_TIMEOUT="30000"
EXPO_PUBLIC_MAX_RETRY_ATTEMPTS="3"

# =======================
# Push Notifications
# =======================
# Configure in EAS Console for production
EXPO_PUBLIC_PUSH_NOTIFICATION_CHANNEL="eventconnect-notifications"

# =======================
# Maps & Location
# =======================
EXPO_PUBLIC_DEFAULT_LATITUDE="-34.6118"
EXPO_PUBLIC_DEFAULT_LONGITUDE="-58.3960"
EXPO_PUBLIC_DEFAULT_LOCATION_RADIUS="25"

# =======================
# File Upload
# =======================
EXPO_PUBLIC_MAX_FILE_SIZE="10485760"
EXPO_PUBLIC_SUPPORTED_IMAGE_FORMATS="jpg,jpeg,png,webp"
EXPO_PUBLIC_SUPPORTED_VIDEO_FORMATS="mp4,mov"

# =======================
# Social Features
# =======================
EXPO_PUBLIC_ENABLE_SOCIAL_SHARING=true
EXPO_PUBLIC_ENABLE_EVENT_SHARING=true
EXPO_PUBLIC_ENABLE_PROFILE_SHARING=true

# =======================
# Debug & Development
# =======================
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL="info"
EXPO_PUBLIC_ENABLE_FLIPPER=false

# Dominio web real opcional para compartir votaciones desde móvil.
# Si está vacío, se comparte el enlace de la app generado por Expo Linking.
EXPO_PUBLIC_WEB_URL=

# Release: el comando npm run release:check exige URLs públicas seguras.
EXPO_PUBLIC_EAS_PROJECT_ID=
ANDROID_GOOGLE_MAPS_API_KEY=
