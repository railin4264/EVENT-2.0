# ============================================
# EventConnect 2.0 Backend - Variables de Entorno
# ============================================
# Copia este archivo a .env y rellena los valores

# ============================================
# ENTORNO
# ============================================
NODE_ENV=development
# Opciones: development, staging, production

PORT=5000
HOST=localhost

# ============================================
# BASE DE DATOS
# ============================================
# MongoDB - Local
MONGODB_URI=mongodb://localhost:27017/eventconnect

# MongoDB Atlas (Producción)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/eventconnect?retryWrites=true&w=majority

MONGODB_TEST_URI=mongodb://localhost:27017/eventconnect_test

# ============================================
# REDIS (Cache y Sesiones)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Redis Cloud (Producción)
# REDIS_URL=redis://<username>:<password>@<host>:<port>

# ============================================
# JWT (Autenticación)
# ============================================
# IMPORTANTE: Generar secrets únicos para producción
# Comando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=CAMBIAR_EN_PRODUCCION_generar_con_comando_arriba
JWT_REFRESH_SECRET=CAMBIAR_EN_PRODUCCION_generar_con_comando_arriba
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
# Separar múltiples orígenes con coma
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081
CORS_CREDENTIALS=true

# ============================================
# CLOUDINARY (Imágenes)
# ============================================
# Obtener de: https://cloudinary.com/console
# 1. Crear cuenta gratuita
# 2. Dashboard > Account Details

CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# ============================================
# GOOGLE MAPS (Geolocalización)
# ============================================
# Obtener de: https://console.cloud.google.com/
# 1. Crear proyecto
# 2. APIs & Services > Credentials > Create API Key
# 3. Habilitar: Maps JavaScript API, Places API, Geocoding API

GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_aqui

# ============================================
# STRIPE (Pagos)
# ============================================
# Obtener de: https://dashboard.stripe.com/apikeys
# Test keys empiezan con sk_test_ y pk_test_
# Live keys empiezan con sk_live_ y pk_live_

STRIPE_SECRET_KEY=sk_test_tu_secret_key_aqui
STRIPE_PUBLISHABLE_KEY=pk_test_tu_publishable_key_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui

# Para obtener el webhook secret:
# 1. Dashboard > Developers > Webhooks
# 2. Add endpoint: https://tu-dominio.com/api/payments/webhook
# 3. Copiar el Signing secret

# ============================================
# FIREBASE (Push Notifications)
# ============================================
# Obtener de: https://console.firebase.google.com/
# 1. Crear proyecto
# 2. Project Settings > Service Accounts
# 3. Generate new private key

FIREBASE_PROJECT_ID=tu_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_private_key_aqui\n-----END PRIVATE KEY-----"

# Alternativa: Usar archivo de credenciales
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# ============================================
# EMAIL (SMTP)
# ============================================
# Gmail: Usar "App Passwords" (no la contraseña normal)
# https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password_aqui
SMTP_FROM=EventConnect <noreply@eventconnect.com>

# ============================================
# SEGURIDAD
# ============================================
BCRYPT_ROUNDS=12
SESSION_SECRET=generar_secret_unico_aqui
HELMET_CSP_ENABLED=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
# 15 minutos en milisegundos
RATE_LIMIT_MAX_REQUESTS=100
# Máximo de requests por ventana

# ============================================
# MONITOREO (Opcional)
# ============================================
# Sentry - https://sentry.io/
SENTRY_DSN=

# Logging
LOG_LEVEL=info
# Opciones: error, warn, info, debug
ENABLE_REQUEST_LOGGING=true

# ============================================
# FEATURES (Flags)
# ============================================
ENABLE_SWAGGER=true
ENABLE_GRAPHQL=false
ENABLE_WEBSOCKETS=true
ENABLE_FILE_UPLOADS=true

# ============================================
# DESARROLLO
# ============================================
DEBUG=eventconnect:*
ENABLE_DEV_ROUTES=true
# Deshabilitar en producción

# ============================================
# PRODUCCIÓN - Checklist
# ============================================
# [ ] Cambiar NODE_ENV a production
# [ ] Generar nuevos JWT_SECRET y JWT_REFRESH_SECRET
# [ ] Configurar MongoDB Atlas
# [ ] Configurar Redis Cloud
# [ ] Usar Stripe live keys
# [ ] Configurar dominio en CORS_ORIGIN
# [ ] Deshabilitar ENABLE_DEV_ROUTES
# [ ] Configurar SENTRY_DSN
# [ ] Verificar HTTPS habilitado
# [ ] Configurar backup de base de datos
