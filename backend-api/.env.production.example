# =================================================
# EVENTCONNECT 2.0 - BACKEND PRODUCTION CONFIG
# =================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Fill in all secrets (marked with TODO or your_*)
# 3. NEVER commit the real .env.production file
# =================================================

# --- Environment ---
NODE_ENV=production
PORT=5000
# HOST=0.0.0.0

# --- Database (MongoDB Atlas / Railway) ---
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://TODO_USER:TODO_PASSWORD@TODO_CLUSTER.mongodb.net/eventconnect_production

# --- Redis (Upstash / Redis Cloud) ---
# Format: redis://:<password>@<host>:<port>
REDIS_URL=redis://:TODO_PASSWORD@TODO_HOST:TODO_PORT

# --- Security & Auth ---
# Generate a random 64-char string: openssl rand -hex 64
JWT_SECRET=TODO_GENERATE_POWERFUL_SECRET_KEY
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# --- CORS (Strict Production Domains) ---
# Comma separated list of allowed origins
CORS_ORIGIN=https://eventconnect.app,https://www.eventconnect.app,https://admin.eventconnect.app

# --- File Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=TODO_CLOUD_NAME
CLOUDINARY_API_KEY=TODO_API_KEY
CLOUDINARY_API_SECRET=TODO_API_SECRET
MAX_FILE_SIZE=10485760 # 10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# --- Email (SendGrid / AWS SES) ---
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=TODO_SENDGRID_API_KEY
EMAIL_FROM=EventConnect <support@eventconnect.app>

# --- Social Auth ---
GOOGLE_CLIENT_ID=TODO_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TODO_GOOGLE_CLIENT_SECRET
FACEBOOK_APP_ID=TODO_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=TODO_FACEBOOK_APP_SECRET

# --- Payments (Stripe Live) ---
STRIPE_SECRET_KEY=sk_live_TODO
STRIPE_WEBHOOK_SECRET=whsec_TODO

# --- Integrations ---
GOOGLE_MAPS_API_KEY=TODO_GOOGLE_MAPS_KEY
SENTRY_DSN=https://TODO@sentry.io/TODO

# --- Rate Limiting (Higher for Prod) ---
RATE_LIMIT_WINDOW_MS=900000 # 15 min
RATE_LIMIT_MAX_REQUESTS=500

# --- Logging ---
LOG_LEVEL=info
