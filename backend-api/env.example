# EventConnect 2.0 Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=5000
HOST=localhost

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
MONGODB_URI=mongodb://localhost:27017/eventconnect
MONGODB_TEST_URI=mongodb://localhost:27017/eventconnect_test

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===========================================
# JWT CONFIGURATION
# ===========================================
# Generate a secure JWT secret (64+ characters)
JWT_SECRET=your_super_secure_jwt_secret_here_minimum_64_characters
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_here_minimum_64_characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006,http://localhost:19000
CORS_CREDENTIALS=true

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=EventConnect <noreply@eventconnect.com>

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# SECURITY
# ===========================================
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here
HELMET_CSP_ENABLED=true

# ===========================================
# MONITORING & LOGGING
# ===========================================
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_SWAGGER=true
ENABLE_GRAPHQL=false
ENABLE_WEBSOCKETS=true
ENABLE_FILE_UPLOADS=true

# ===========================================
# DEVELOPMENT
# ===========================================
DEBUG=eventconnect:*
ENABLE_DEV_ROUTES=true

# ===========================================
# SECURITY WARNING
# ===========================================
# NEVER commit the actual .env file to version control!
# This file contains sensitive information that should remain private.
# 
# To set up your environment:
# 1. Copy this file: cp env.example .env
# 2. Fill in your actual API keys and configuration
# 3. Make sure .env is in your .gitignore file
# 4. Generate secure secrets using: node scripts/generate-secrets.js
#
# For production, set these variables in your hosting platform's
# environment variables section.


# Event ingestion (real sources only; imports land in pending_review)
EVENT_INGESTION_ENABLED=true
EVENT_AGGREGATOR_ENABLED=false
TICKETMASTER_API_KEY=
SONGKICK_API_KEY=
# Comma-separated public calendar feeds
ICS_FEEDS=
JSON_EVENT_FEEDS=
# Cities queried each cycle: name|lat|lng|radiusKm separated by ';'
INGESTION_ZONES=Santo Domingo|18.4861|-69.9312|60;Santiago de los Caballeros|19.4517|-70.6970|40;Punta Cana|18.5820|-68.4055|40
# Demo catalogs (fabricated dates) only ever run with NODE_ENV=development
ENABLE_DEMO_DATA=false
