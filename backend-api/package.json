{
  "name": "eventconnect-backend-api",
  "version": "2.0.0",
  "description": "EventConnect Backend API - Modern & Clean Architecture",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "echo 'No build step required for Node.js'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "docker:build": "docker build -t eventconnect-backend .",
    "docker:run": "docker run -p 5000:5000 eventconnect-backend",
    "db:indexes": "node scripts/mongodb-indexes.js",
    "db:performance": "node scripts/mongodb-performance.js",
    "db:optimize": "npm run db:indexes && npm run db:performance"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@faker-js/faker": "^10.3.0",
    "@sentry/node": "^7.99.0",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^9.6.3",
    "helmet": "^7.2.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.7",
    "qrcode": "^1.5.3",
    "redis": "^4.6.12",
    "sharp": "^0.33.2",
    "socket.io": "^4.7.4",
    "speakeasy": "^2.0.0",
    "stripe": "^18.5.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "eventconnect",
    "backend",
    "api",
    "express",
    "mongodb",
    "redis",
    "socket.io"
  ],
  "author": "EventConnect Team",
  "license": "MIT"
}
