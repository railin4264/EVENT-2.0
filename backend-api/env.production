# ===========================================
# EVENTCONNECT 2.0 - PRODUCTION ENVIRONMENT
# ===========================================

# Server Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eventconnect_prod?retryWrites=true&w=majority
MONGODB_OPTIONS={"useNewUrlParser":true,"useUnifiedTopology":true,"maxPoolSize":10,"serverSelectionTimeoutMS":5000,"socketTimeoutMS":45000}

# Redis Configuration
REDIS_URL=redis://username:password@redis-cluster:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-for-production-minimum-64-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=eventconnect.com
JWT_AUDIENCE=eventconnect-users

# CORS Configuration
CORS_ORIGIN=https://eventconnect.com,https://www.eventconnect.com,https://app.eventconnect.com
CORS_CREDENTIALS=true

# External Services
# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_for_production

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=eventconnect/production

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=live

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@eventconnect.com
SMTP_PASS=your_smtp_password
SMTP_FROM=EventConnect <noreply@eventconnect.com>

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,application/pdf

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-for-production
HELMET_CSP_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Monitoring
SENTRY_DSN=your_sentry_dsn_for_error_tracking
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_GAMIFICATION=true
ENABLE_CHAT=true
ENABLE_NOTIFICATIONS=true
ENABLE_PAYMENTS=true
ENABLE_MAPS=true
ENABLE_FILE_UPLOAD=true

# Performance
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=eventconnect-backups
BACKUP_S3_REGION=us-east-1

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
















