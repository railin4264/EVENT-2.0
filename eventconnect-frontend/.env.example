# =======================
# EVENTCONNECT 2.0 - FRONTEND CONFIGURATION
# =======================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EventConnect 2.0
NEXT_PUBLIC_APP_VERSION=2.0.0

# Maps & Geolocation
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dtzxi9meh
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=eventconnect

# Social Auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id

# Payment
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-your-ga4-id
NEXT_PUBLIC_HOTJAR_ID=your_hotjar_id

# Feature Flags
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Development
NEXT_PUBLIC_DEBUG_MODE=false

# SEO & Meta
NEXT_PUBLIC_SITE_NAME=EventConnect 2.0
NEXT_PUBLIC_SITE_DESCRIPTION=Discover amazing events, connect with like-minded people, and create unforgettable experiences.
NEXT_PUBLIC_SITE_KEYWORDS=events,social,community,networking,meetups,activities

# PWA
NEXT_PUBLIC_PWA_ENABLED=true

# Security
NEXT_PUBLIC_ENABLE_CSP=true