# =================================================
# EVENTCONNECT 2.0 - FRONTEND PRODUCTION CONFIG
# =================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local (or .env.production)
# 2. Add these secrets to your deployment platform (Vercel/Netlify)
# =================================================

# --- Base URL ---
# The URL of your deployed backend API
NEXT_PUBLIC_API_URL=https://api.eventconnect.app/api
NEXT_PUBLIC_WS_URL=wss://api.eventconnect.app
NEXT_PUBLIC_APP_URL=https://eventconnect.app

# --- Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=TODO_GOOGLE_MAPS_KEY

# --- Analytics ---
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-TODO
NEXT_PUBLIC_SENTRY_DSN=https://TODO@sentry.io/TODO

# --- Payments ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_TODO

# --- Social Auth IDs ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=TODO_GOOGLE_CLIENT_ID
NEXT_PUBLIC_FACEBOOK_APP_ID=TODO_FACEBOOK_APP_ID

# --- Feature Flags (Production) ---
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_PWA_ENABLED=true
